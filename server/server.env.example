# comfyui-remote server settings, read by the comfyui.service user unit and the comfyui wrapper.
# KEY=value lines in systemd EnvironmentFile syntax: quote values that contain spaces.
# Uncomment what you need.

# Where ComfyUI is checked out (default ~/ComfyUI), and the Python that runs it
# (default .venv/bin/python inside COMFYUI_DIR).
#COMFYUI_DIR=/home/me/ComfyUI
#COMFYUI_PYTHON=/home/me/ComfyUI/.venv/bin/python

# Port on the server's loopback (match COMFYUI_REMOTE_PORT on the client).
#COMFYUI_PORT=8188

# Extra ComfyUI arguments, e.g. models on another disk or no paid API nodes.
#COMFYUI_ARGS="--disable-api-nodes --models-directory /mnt/data/models"

# Model caches.
#HF_HOME=/mnt/data/cache/huggingface
#TORCH_HOME=/mnt/data/cache/torch
